=== chinook-nested.tugql.yaml
sql: SELECT "i"."InvoiceId" AS "invoice_id", "c"."FirstName" AS "customer", "e"."FirstName" AS "employee" FROM "main"."Invoice" "i" INNER JOIN ("main"."Customer" "c" LEFT JOIN "main"."Employee" "e" ON ("c"."SupportRepId" = "e"."EmployeeId")) ON ("i"."CustomerId" = "c"."CustomerId") WHERE "c"."CustomerId" >= :1 ORDER BY "i"."InvoiceId" DESC FETCH FIRST :2 ROWS ONLY
#1 int64 10
#2 int64 10
=== chinook-hinted.tugql.yaml
sql: SELECT "i"."InvoiceId" AS "invoice_id", "c"."FirstName" AS "customer", "e"."FirstName" AS "employee" FROM "main"."Invoice" "i" INNER JOIN ("main"."Customer" "c" LEFT JOIN "main"."Employee" "e" ON ("c"."SupportRepId" = "e"."EmployeeId")) ON ("i"."CustomerId" = "c"."CustomerId") LEFT JOIN "main"."Customer" "c2" ON ("i"."CustomerId" = "c2"."CustomerId") WHERE "c"."CustomerId" >= :1 ORDER BY "i"."InvoiceId" DESC FETCH FIRST :2 ROWS ONLY
#1 int64 10
#2 int64 10
=== chinook-wildcard.tugql.yaml
refused: not supported: wildcard projection must precede explicit columns
=== inner join
sql: SELECT "a"."Title", "r"."Name" AS "artist" FROM "Album" "a" INNER JOIN "Artist" "r" ON ("a"."ArtistId" = "r"."ArtistId")
=== left join with two key pairs, then a default join type
sql: SELECT "e"."FirstName" AS "rep" FROM "Customer" "c" LEFT JOIN "Employee" "e" ON ("c"."SupportRepId" = "e"."EmployeeId" AND "c"."FirstName" = "e"."FirstName") INNER JOIN "Invoice" "i" ON ("c"."CustomerId" = "i"."CustomerId")
=== ORDER BY on the preserved and on the nullable side of a left join
sql: SELECT * FROM "Album" "a" LEFT JOIN "Artist" "r" ON ("a"."ArtistId" = "r"."ArtistId") ORDER BY "a"."AlbumId" ASC, "r"."ArtistId" ASC NULLS FIRST
=== aggregation over a join
sql: SELECT "c"."Country" AS "country", (CAST(SUM("i"."Total") AS BINARY_DOUBLE)) AS "revenue" FROM "Invoice" "i" INNER JOIN "Customer" "c" ON ("i"."CustomerId" = "c"."CustomerId") GROUP BY "c"."Country" HAVING (CAST(SUM("i"."Total") AS BINARY_DOUBLE)) > :1 ORDER BY (CAST(SUM("i"."Total") AS BINARY_DOUBLE)) DESC NULLS LAST FETCH FIRST :2 ROWS ONLY
#1 int64 1000
#2 int64 10
=== key types that differ are refused before the server sees them
refused: not supported: from.joins[0].on[0]: join_plan: key types differ ("integer" against "text")
=== a join key that is not a column is an error
error: from.joins[0].on[0].right: field "to_json" is not a column of source "r"
=== a join without facts is not type checked
sql: SELECT * FROM "Album" "a" INNER JOIN "Artist" "r" ON ("a"."ArtistId" = "r"."Name")
=== a right join is refused
refused: not supported: join_type at from.joins[0].type: unsupported join type "RIGHT"
=== a scan-bounded source needs the generic engine
refused: not supported: from: join_plan: a scan-bounded source needs the generic engine
