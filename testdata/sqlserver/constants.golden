=== a string that looks like a date is read by the server
sql: SELECT * FROM "Album" WHERE "Album"."Title" = @p1
#1 string "2026-10-04"
=== bool true
sql: SELECT * FROM "Album" WHERE "Album"."Title" = @p1
#1 bool true
