=== select all
sql: SELECT * FROM "Album"
=== columns and aliases
sql: SELECT "Title", "AlbumId" AS "id" FROM "Album"
=== schema-qualified source with an alias
sql: SELECT "a"."Title" FROM "public"."Album" AS "a"
=== a select-all expanded from the catalog facts, minus exclusions
sql: SELECT "CustomerId", "FirstName", "LastName", "Country" FROM "Customer"
=== a select-all with a mask and an explicit column after it
sql: SELECT "CustomerId", "FirstName", "LastName", "Country", "Email" AS "mail" FROM "Customer"
=== a select-all whose exclusion is in the catalog's own spelling
sql: SELECT "CustomerId", "FirstName", "LastName", "Country" FROM "Customer"
=== a select-all needs the catalog facts
refused: column 0: not supported: a wildcard projection needs catalog facts for its source
=== an unaliased expression is named by its text
sql: SELECT ((("a")::double precision) + (("b")::double precision)) AS "(a + b)" FROM "Album"
=== a constant in the select list needs an alias
sql: SELECT $1::bigint AS "five" FROM "Album"
$1 int64 5
=== an unaliased expression carrying a constant is refused
refused: column 0: not supported: an expression carrying a constant needs an alias
=== an alias of 63 bytes is accepted
sql: SELECT "Title" AS "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" FROM "Album"
=== an alias over 63 bytes is declined, the generic engine labels the column
refused: column 0: not supported: an output name is too long for the engine, which cannot spell it as a column label: identifier is 64 bytes, over the engine limit of 63
=== the text of an unaliased expression over 63 bytes is declined
refused: column 0: not supported: an output name is too long for the engine, which cannot spell it as a column label: identifier is 65 bytes, over the engine limit of 63
=== two outputs that are one name once folded
sql: SELECT "Title", "TITLE" FROM "Album"
=== count(*) is named as DALgo names it
sql: SELECT COUNT(*) AS "COUNT(*)" FROM "Invoice"
=== dal.ID names a real column and is read as one
sql: SELECT * FROM "Album" WHERE "AlbumId" = $1::bigint
$1 int64 7
=== dal.ID with a string key
sql: SELECT * FROM "Album" WHERE "Title" = $1
$1 string "Ada"
=== a scan-bounded source whose scan the statement restates
sql: SELECT "InvoiceId", "Total" FROM "Invoice" ORDER BY "InvoiceDate" DESC LIMIT $1
$1 int64 10
=== a scan-bounded source with a statement limit below the scan's
sql: SELECT * FROM "Invoice" ORDER BY "InvoiceDate" DESC LIMIT $1
$1 int64 4
=== a scan-bounded source with a WHERE is declined
refused: not supported: from: a scan-bounded source compiles only when the statement restates its scan: WHERE filters after the scan, not before it
=== equality
sql: SELECT * FROM "Album" WHERE "AlbumId" = $1::bigint
$1 int64 7
=== every comparison operator in AND and OR groups
sql: SELECT * FROM "Album" WHERE ("a" > $1::bigint AND "b" >= $2::bigint AND ("c" < $3::bigint OR "d" <= $4::bigint OR "e" = $5))
$1 int64 1
$2 int64 2
$3 int64 3
$4 int64 4
$5 string "five"
=== equal to null is IS NULL and binds nothing
sql: SELECT * FROM "Album" WHERE "Title" IS NULL
=== is null
sql: SELECT * FROM "Album" WHERE "Title" IS NULL
=== is not null
sql: SELECT * FROM "Album" WHERE "Title" IS NOT NULL
=== ordering against null stays a bound NULL
sql: SELECT * FROM "Album" WHERE "AlbumId" > $1
$1 nil
=== IN list
sql: SELECT * FROM "Album" WHERE "AlbumId" IN ($1::bigint, $2::numeric, $3)
$1 int64 1
$2 string "2.5"
$3 string "three"
=== NOT IN list
sql: SELECT * FROM "Album" WHERE "Title" NOT IN ($1, $2)
$1 string "a"
$2 string "b"
=== IN list with a NULL keeps three-valued logic
sql: SELECT * FROM "Album" WHERE "AlbumId" NOT IN ($1::bigint, $2)
$1 int64 1
$2 nil
=== empty IN is FALSE
sql: SELECT * FROM "Album" WHERE FALSE
=== empty NOT IN is TRUE
sql: SELECT * FROM "Album" WHERE TRUE
=== add subtract multiply
sql: SELECT ((("a")::double precision) + (("b")::double precision)) AS "s", ((("a")::double precision) - (($1::bigint)::double precision)) AS "d", ((($2::numeric)::double precision) * (("b")::double precision)) AS "m" FROM "Album"
$1 int64 2
$2 string "2.5"
=== divide is on double precision with a zero divisor read as NULL
sql: SELECT (("a")::double precision / NULLIF(("b")::double precision, 0)) AS "q" FROM "Album"
=== nested division keeps argument order
sql: SELECT ((((("a")::double precision) + (($1::bigint)::double precision)))::double precision / NULLIF((((("b")::double precision) - (($2::bigint)::double precision)))::double precision, 0)) AS "q" FROM "Album"
$1 int64 1
$2 int64 2
=== division where both operands render the same text
sql: SELECT ((((("a")::double precision) + (($1::bigint)::double precision)))::double precision / NULLIF((((("a")::double precision) + (($2::bigint)::double precision)))::double precision, 0)) AS "q" FROM "Album"
$1 int64 1
$2 int64 2
=== COUNT(*)
sql: SELECT COUNT(*) AS "COUNT(*)" FROM "Invoice"
=== every aggregate
sql: SELECT COUNT("InvoiceId") AS "n", ((SUM("Total"))::double precision) AS "sum", ((AVG("Total"))::double precision) AS "avg", MIN("Total") AS "min", MAX("Total") AS "max" FROM "Invoice"
=== distinct aggregates
sql: SELECT COUNT(DISTINCT "CustomerId") AS "customers", ((SUM(DISTINCT "Total"))::double precision) AS "sum", ((AVG(DISTINCT "Total"))::double precision) AS "avg" FROM "Invoice"
=== GROUP BY with HAVING and ORDER BY through select aliases
sql: SELECT "BillingCountry" AS "country", ((SUM("Total"))::double precision) AS "revenue", COUNT("InvoiceId") AS "invoices" FROM "Invoice" GROUP BY "BillingCountry" HAVING ((SUM("Total"))::double precision) > $1::bigint ORDER BY ((SUM("Total"))::double precision) DESC NULLS LAST, "BillingCountry" ASC NULLS FIRST LIMIT $2
$1 int64 1000
$2 int64 10
=== a grouped expression carrying a constant is referenced by position
sql: SELECT ((("Total")::double precision) + (($1::bigint)::double precision)) AS "bucket", COUNT("InvoiceId") AS "n" FROM "Invoice" GROUP BY 1 ORDER BY 1 ASC NULLS FIRST
$1 int64 100
=== GROUP BY without selected columns groups by its keys
sql: SELECT "BillingCountry" FROM "Invoice" GROUP BY "BillingCountry"
=== FIRST needs an input order SQL does not give
refused: not supported: FIRST/LAST require a provider-declared stable input order; aggregate ORDER BY is not yet supported
=== an aggregate in WHERE is refused
error: where: aggregate functions are not allowed in WHERE
=== ORDER BY without facts keeps the NULLS clause
sql: SELECT * FROM "Album" ORDER BY "AlbumId" ASC NULLS FIRST, "Title" DESC NULLS LAST
=== ORDER BY a NOT NULL column drops the NULLS clause
sql: SELECT * FROM "Album" ORDER BY "AlbumId" ASC, "AlbumId" DESC, "Title" DESC
=== ORDER BY a nullable column keeps the NULLS clause
sql: SELECT * FROM "Artist" ORDER BY "Name" ASC NULLS FIRST, "Name" DESC NULLS LAST
=== ORDER BY an aggregate
sql: SELECT "BillingCountry", ((SUM("Total"))::double precision) AS "revenue" FROM "Invoice" GROUP BY "BillingCountry" ORDER BY ((SUM("Total"))::double precision) DESC NULLS LAST
=== LIMIT
sql: SELECT * FROM "Album" LIMIT $1
$1 int64 10
=== OFFSET
sql: SELECT * FROM "Album" OFFSET $1
$1 int64 5
=== LIMIT and OFFSET
sql: SELECT * FROM "Album" LIMIT $1 OFFSET $2
$1 int64 10
$2 int64 5
=== numbering follows the text across clauses
sql: SELECT "g", (((COUNT(*))::double precision) + (($1::bigint)::double precision)) AS "n" FROM "Invoice" WHERE "a" = $2::bigint GROUP BY "g" HAVING ((SUM("t"))::double precision) > $3::bigint ORDER BY ((("g")::double precision) + (($4::bigint)::double precision)) ASC NULLS FIRST LIMIT $5 OFFSET $6
$1 int64 6
$2 int64 1
$3 int64 2
$4 int64 3
$5 int64 4
$6 int64 5
=== identifiers that hold quotes, question marks and spaces are quoted
sql: SELECT "we?ird""col" AS "a?""b" FROM "tab?le""x" WHERE "we?ird""col" = $1::bigint ORDER BY "we?ird""col" ASC NULLS FIRST
$1 int64 1
=== names with non-ASCII capitals
sql: SELECT "Élève" AS "Prénom" FROM "Écoles" WHERE "Élève" = $1::bigint
$1 int64 1
=== a name over 63 bytes is refused, never truncated
error: from: table name: identifier is 64 bytes, over the engine limit of 63
=== a name of 44 bytes that folds to 66 is refused in FoldLower only
sql: SELECT * FROM "ȺȺȺȺȺȺȺȺȺȺȺȺȺȺȺȺȺȺȺȺȺȺ"
=== a name that is a bare source identity without facts is refused
refused: column 0: not supported: field "x" is written as the identity of its source "x", which the server reads as the whole row unless a column has that name, and no catalog facts say whether one does
=== a name that is not a column of a known source is an error
error: column 0: field "to_json" is not a column of source "x"
=== subqueries run in the generic engine
refused: not supported: subqueries run in the generic engine, not in one statement
=== cursors are refused
refused: not supported: cursors (startFrom, startAfter)
